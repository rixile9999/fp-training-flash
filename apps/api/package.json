    "@fp/content": "workspace:*",
    "@fp/grading": "workspace:*",
    "@fp/learner": "workspace:*",
    "@fp/lessons": "workspace:*",
    "@fp/sessions": "workspace:*",
    "@fp/coaching": "workspace:*",
    "hono": "^4.13.11",
    "@hono/node-server": "^2.1.3",
    "zod": "^4.6.5"
  }
}
